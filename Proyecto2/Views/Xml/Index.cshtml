@{
    ViewData["Title"] = "Cargar XML";
}

<h1>Cargar Archivo XML</h1>

@if (ViewBag.Error != null)
{
    <div style="color: red; background: #fee; padding: 10px; border-radius: 4px;">
        @ViewBag.Error
    </div>
}

<p>Selecciona un archivo XML con la estructura del catálogo para cargarlo al sistema.</p>

<form asp-controller="Xml" asp-action="Cargar" method="post" enctype="multipart/form-data">
    <input type="file" name="archivo" accept=".xml" required />
    <button type="submit">Cargar XML</button>
</form>

<h2>Formato esperado</h2>
<pre>
&lt;libreria&gt;
    &lt;listaCategorias&gt;
        &lt;categoria nombre="Ficción"&gt;
            &lt;categoria nombre="Novela"/&gt;
        &lt;/categoria&gt;
    &lt;/listaCategorias&gt;
    &lt;listaLibros&gt;
        &lt;libro isbn="123" titulo="Cien años" autor="García Márquez"&gt;
            &lt;categoria&gt;Novela&lt;/categoria&gt;
        &lt;/libro&gt;
    &lt;/listaLibros&gt;
&lt;/libreria&gt;
</pre>

<p><a asp-controller="Home" asp-action="Index">Volver al inicio</a></p>
