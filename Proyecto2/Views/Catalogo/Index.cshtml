@model ArbolCategoria.Arbol_Categoria
@{
    ViewData["Title"] = "Catálogo";
}

<h1>Catálogo de Categorías</h1>

@if (TempData["Error"] != null)
{
    <div style="color: red; background: #fee; padding: 10px; border-radius: 4px;">
        @TempData["Error"]
    </div>
}

<h2>Agregar categoría</h2>
<form asp-controller="Catalogo" asp-action="AgregarCategoria" method="post">
    <input type="text" name="nombre" placeholder="Nombre nueva categoría" required />
    <input type="text" name="padre" placeholder="Padre (vacío si es raíz)" />
    <button type="submit">Agregar</button>
</form>

<h2>Agregar libro</h2>
<form asp-controller="Libro" asp-action="Agregar" method="post">
    <input type="number" name="isbn" placeholder="ISBN" required />
    <input type="text" name="titulo" placeholder="Título" required />
    <input type="text" name="autor" placeholder="Autor" required />
    <input type="text" name="categoria" placeholder="Categoría" required />
    <button type="submit">Agregar libro</button>
</form>

<h2>Eliminar libro</h2>
<form asp-controller="Libro" asp-action="Eliminar" method="post">
    <input type="number" name="isbn" placeholder="ISBN a eliminar" required />
    <input type="text" name="categoria" placeholder="Categoría del libro" required />
    <button type="submit">Eliminar</button>
</form>

<h2>Estructura completa</h2>
<pre>
@{
    System.Text.StringBuilder sb = new System.Text.StringBuilder();
    void Rec(Nodo_Categoria.Nodo_categoria? n, int nivel)
    {
        if (n == null) return;
        sb.AppendLine(new string(' ', nivel * 4) + n.Nodo_actual.nombre_categoria);
        var h = n.Nodo_actual.lista_hijos.raiz;
        while (h != null) { Rec(h, nivel + 1); h = h.siguiente; }
    }
    Rec(Model.raiz, 0);
}
@sb.ToString()
</pre>

<p><a asp-controller="Home" asp-action="Index">Volver al inicio</a></p>
